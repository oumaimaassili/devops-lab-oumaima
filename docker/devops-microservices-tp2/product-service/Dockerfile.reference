# Student task in TP3: create Dockerfile based on this application.
# This reference is intentionally named Dockerfile.reference so students must build it themselves.
FROM python:3.12-slim
WORKDIR /app
COPY product-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY product-service/app.py .
EXPOSE 8001
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001"]
